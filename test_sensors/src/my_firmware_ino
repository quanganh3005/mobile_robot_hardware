#ifndef BAUDRATE
#define BAUDRATE 115200
#endif

// Khai báo biến chứa dữ liệu IMU
sensor_msgs__msg__Imu imu_msg;
IMU imu;

void setup() 
{
#ifdef BOARD_INIT 
    BOARD_INIT;
#endif

    Serial.begin(BAUDRATE);

    // In ra một dòng xuống dòng trống để đẩy hết rác đi
    Serial.println(); 
    Serial.flush(); // Đợi cho dữ liệu đẩy đi hết
    delay(100);     // Dừng một chút cho mọi thứ ổn định
    
    // --- KHỞI TẠO I2C CHO MPU6050 ---
#ifdef SDA_PIN 
#ifdef ESP32
    Wire.begin(SDA_PIN, SCL_PIN);
#else 
    Wire.setSDA(SDA_PIN);
    Wire.setSCL(SCL_PIN);
#endif
#endif

    // --- KHỞI TẠO WIFI VÀ OTA ---
    // Robot sẽ kết nối wifi dựa trên thông tin trong config.h
    // initWifis(); 
    // initOta();

    Serial.println("--- SENSOR TEST START ---");
    Serial.println("Initializing IMU (MPU6050)...");
    
    // bool imu_success = imu.init();
    
    // if(imu_success) {
    //     Serial.println("IMU Initialized SUCCESSFULLY!");
    // } else {
    //     Serial.println("IMU Initialization FAILED! Check wiring (SDA/SCL) or Power.");
    // }

    imu.init();
    Serial.println("IMU Initialized FORCEFULLY (Skipped ID Check)");
}

void loop() {
    // --- DUY TRÌ KẾT NỐI WIFI VÀ OTA ---
    // runWifis();
    // runOta();

    // Đọc dữ liệu từ MPU6050
    imu_msg = imu.getData();

    // In ra Serial Monitor hoặc Log qua Wifi
    // Linear Acceleration (Gia tốc tuyến tính - m/s^2)
    // Angular Velocity (Vận tốc góc - rad/s)
    
    // 1. In ra Serial Monitor (Dùng cáp USB)
    Serial.printf("ACC [x,y,z]: %5.2f %5.2f %5.2f | GYR [x,y,z]: %5.2f %5.2f %5.2f\n",
       imu_msg.linear_acceleration.x, 
       imu_msg.linear_acceleration.y, 
       imu_msg.linear_acceleration.z,
       imu_msg.angular_velocity.x, 
       imu_msg.angular_velocity.y, 
       imu_msg.angular_velocity.z
    );

    // 2. Gửi Log qua WiFi (Syslog)
    // Nếu bạn không cắm dây USB, bạn có thể xem log này qua mạng
    // syslog(LOG_INFO, "ACC [x,y,z]: %5.2f %5.2f %5.2f | GYR [x,y,z]: %5.2f %5.2f %5.2f\n",
    //    imu_msg.linear_acceleration.x, 
    //    imu_msg.linear_acceleration.y, 
    //    imu_msg.linear_acceleration.z,
    //    imu_msg.angular_velocity.x, 
    //    imu_msg.angular_velocity.y, 
    //    imu_msg.angular_velocity.z
    // );

    delay(200); // Update 5 lần/giây
}